# ==============================================================================
# BIẾN MÔI TRƯỜNG MẪU (ENV TEMPLATE) - TRƯỜNG TIỂU HỌC LÊ LỢI
# LƯU Ý BẢO MẬT:
# 1. KHÔNG commit file .env chứa giá trị thật lên GitHub.
# 2. KHÔNG nhập key thật vào file .env.example này.
# 3. KHÔNG sử dụng VITE_GEMINI_API_KEY nếu muốn bảo mật key (mọi tiền tố VITE_ đều bị public ra trình duyệt).
# 4. Khi chạy trên AI Studio hoặc Cloud Run, GEMINI_API_KEY được tự động tiêm an toàn vào server.
# ==============================================================================

# Gemini AI API Key (Chỉ đọc từ server backend, không gửi về client)
GEMINI_API_KEY=""

# Địa chỉ URL của ứng dụng
APP_URL="https://truongthleloipongdrang.github.io/truongthleloipongdrang/"

# Cấu hình gửi mail (tùy chọn cho thông báo quản trị / khôi phục mật khẩu)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="truongthleloipongdrang@gmail.com"
SMTP_PASS=""

# Thông tin xác thực quản trị viên (hash bcrypt hoặc sha256)
ADMIN_USERNAME="bgh_leloi"
ADMIN_PASSWORD_HASH=""
JWT_SECRET=""

# Cấu hình GitHub Pages & Repo
GITHUB_OWNER="truongthyjutpongdrang"
GITHUB_REPO="truongthleloipongdrang"
GITHUB_BRANCH="main"
