rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      // REPLACE with the UID of the sole approved Firebase Authentication user.
      return request.auth != null && request.auth.uid == 'REPLACE_WITH_FIREBASE_ADMIN_UID';
    }
    match /siteData/publicContent {
      allow get: if true;
      allow list: if false;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['payload'])
        && request.resource.data.payload is string
        && request.resource.data.payload.size() < 900000;
      allow delete: if false;
    }
    match /siteData/privateStudents {
      allow get: if isAdmin();
      allow list: if false;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['payload'])
        && request.resource.data.payload is string
        && request.resource.data.payload.size() < 900000;
      allow delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
